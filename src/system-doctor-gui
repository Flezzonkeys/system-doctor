def make_palette(name):
    t = THEMES[name]
    p = QPalette()
    for role, value in t.items():
        if role != "Disabled":
            p.setColor(getattr(QPalette.ColorRole, role), QColor(value))
    for role in ("WindowText", "Text", "ButtonText"):
        p.setColor(QPalette.ColorGroup.Disabled, getattr(QPalette.ColorRole, role), QColor(t["Disabled"]))
    return p


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, type(default)) else default
    except (OSError, ValueError):
        return default


def save_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=1)
        os.replace(tmp, path)
    except OSError:
        pass


def load_seen():
    return set(load_json(SEEN, {}).get("keys", []))


def save_seen(keys, report_checks):
    """Store seen keys, dropping those that are no longer in the report so the file stays small."""
    current = {e["key"] for c in report_checks for e in c.get("events") or []}
    save_json(SEEN, {"keys": sorted(k for k in keys if k in current)})


def effective(check, seen):
    """The check as the user should see it, with events they marked as seen taken out."""
    events = check.get("events") or []
    if not events or check.get("status") == "ok":
        return check
    new = [e for e in events if e["key"] not in seen]
    if len(new) == len(events):
        return check
    c = dict(check)
    c["seen_count"] = len(events) - len(new)
    if not new:
        c["status"] = "ok"
        c["seen"] = True
        c["summary"] = f"Nothing new, {len(events)} marked as seen"
    else:
        labels = ", ".join(e["label"] for e in new[:3]) + (" ..." if len(new) > 3 else "")
        c["summary"] = f"{len(new)} new: {labels} ({c['seen_count']} seen)"
    return c


def unseen_keys(check, seen):
    return [e["key"] for e in check.get("events") or [] if e["key"] not in seen]


# ---------------------------------------------------------------- helpers
def is_dark():
    return QApplication.palette().color(QPalette.ColorRole.Window).lightness() < 128


def status_color(status):
    dark = is_dark()
    return QColor({
        "ok": "#3fb950" if dark else "#1f8f3a",
        "warn": "#e3b341" if dark else "#c27c00",
        "fail": "#f85149" if dark else "#cf2e25",
        "info": "#58a6ff" if dark else "#2f6fca",
        "seen": "#8b949e" if dark else "#6e7781",
    }.get(status, "#888888"))


def mix(a, b, t):
    """Blend colour a towards b by t (0..1)."""
    return QColor(round(a.red() + (b.red() - a.red()) * t), round(a.green() + (b.green() - a.green()) * t),
                  round(a.blue() + (b.blue() - a.blue()) * t))


def pal(role):
    return QApplication.palette().color(role)


def muted():
    return mix(pal(QPalette.ColorRole.WindowText), pal(QPalette.ColorRole.Window), 0.45)


def theme_icon(cid):
    for name in ICONS.get(cid, []) + ["application-x-executable"]:
        if QIcon.hasThemeIcon(name):
            return QIcon.fromTheme(name)
    return QIcon()


def shown_status(check):
    if check.get("info"):
        return "info"
    return "seen" if check.get("seen") else check.get("status", "ok")


def fmt_time(ts):
    dt = datetime.fromtimestamp(ts)
    days = (datetime.now().date() - dt.date()).days
    day = "today" if days == 0 else "yesterday" if days == 1 else \
        "tomorrow" if days == -1 else dt.strftime("%b %d, %Y")
    return f"{day}, {dt.strftime('%H:%M')}"


def systemctl(*args):
    try:
        return subprocess.run(["systemctl", *args], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def is_running():
    return systemctl("is-active", SERVICE) in ("active", "activating")


def next_run():
    try:
        timers = json.loads(systemctl("list-timers", TIMER, "--output=json") or "[]")
        nxt = timers[0].get("next") if timers else None
        return nxt / 1e6 if nxt else None
    except (ValueError, TypeError, AttributeError):
        return None


def status_word(check):
    return WORDS.get(shown_status(check))


def plain_text(check):
    lines = [f"{check.get('title')}: {status_word(check)} - {check.get('summary')}"]
    lines += ["  " + d for d in check.get("details", [])]
    return "\n".join(lines)


# ---------------------------------------------------------------- small widgets
class StatusBadge(QWidget):
    """Round badge with a check mark, exclamation mark or cross."""

    def __init__(self, size=56):
        super().__init__()
        self.status = "ok"
        self.setFixedSize(size, size)

    def set_status(self, status):
        self.status = status
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        c = status_color(self.status)
        r = QRectF(2, 2, self.width() - 4, self.height() - 4)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(c)
        p.drawEllipse(r)
        pen = QPen(QColor("white"), self.width() * 0.09, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap,
                   Qt.PenJoinStyle.RoundJoin)
        p.setPen(pen)
        w = self.width()
        if self.status == "ok":
            path = QPainterPath(QPointF(w * 0.29, w * 0.52))
            path.lineTo(w * 0.44, w * 0.66)
            path.lineTo(w * 0.72, w * 0.36)
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawPath(path)
        elif self.status == "warn":
            p.drawLine(QPointF(w / 2, w * 0.27), QPointF(w / 2, w * 0.56))
            p.drawPoint(QPointF(w / 2, w * 0.73))
        else:
            p.drawLine(QPointF(w * 0.34, w * 0.34), QPointF(w * 0.66, w * 0.66))
            p.drawLine(QPointF(w * 0.66, w * 0.34), QPointF(w * 0.34, w * 0.66))


class Pill(QLabel):
    """Small rounded status label."""

    def __init__(self):
        super().__init__()
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        f = self.font()
        f.setBold(True)
        f.setPointSizeF(f.pointSizeF() * 0.85)
        self.setFont(f)

    def set_status(self, status, text=None):
        c = status_color(status)
        bg = mix(c, pal(QPalette.ColorRole.Base), 0.82)
        self.setText(text or WORDS.get(status, status))
        self.setStyleSheet(f"QLabel {{ color: {c.name()}; background: {bg.name()}; border: 1px solid "
                           f"{mix(c, pal(QPalette.ColorRole.Base), 0.5).name()}; border-radius: 9px; "
                           f"padding: 1px 9px; }}")


class GaugeBar(QWidget):
    """Horizontal fill bar, coloured by the thresholds from the report."""

    def __init__(self, gauge, compact=False):
        super().__init__()
        self.g = gauge
        self.compact = compact
        self.setFixedHeight(6 if compact else 30)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def level(self):
        v = self.g["value"]
        if "fail" in self.g and v >= self.g["fail"]:
            return "fail"
        if "warn" in self.g and v >= self.g["warn"]:
            return "warn"
        return "ok" if "warn" in self.g else "info"

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        base = pal(QPalette.ColorRole.Base)
        track = mix(pal(QPalette.ColorRole.WindowText), base, 0.88)
        bar_h = 6 if self.compact else 8
        y = self.height() - bar_h
        if not self.compact:
            p.setPen(pal(QPalette.ColorRole.WindowText))
            p.drawText(QRectF(0, 0, self.width(), y - 2), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignBottom,
                       self.g["label"])
            p.setPen(muted())
            p.drawText(QRectF(0, 0, self.width(), y - 2), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignBottom,
                       f"{self.g['value']:.0f}%")
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(track)
        p.drawRoundedRect(QRectF(0, y, self.width(), bar_h), bar_h / 2, bar_h / 2)
        fill = self.width() * self.g["value"] / 100
        if fill > 0:
            p.setBrush(status_color(self.level()))
            p.drawRoundedRect(QRectF(0, y, max(fill, bar_h), bar_h), bar_h / 2, bar_h / 2)


# ---------------------------------------------------------------- cards
class Card(QFrame):
    clicked = pyqtSignal(str)

    HEIGHT = 92

    def __init__(self, check):
        super().__init__()
        self.cid = check["id"]
        self.selected = False
        self.hover = False
        self.setFixedHeight(self.HEIGHT)
        self.setMinimumWidth(220)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)

        self.icon = QLabel()
        self.title = QLabel()
        tf = self.title.font()
        tf.setBold(True)
        tf.setPointSizeF(tf.pointSizeF() * 1.08)
        self.title.setFont(tf)
        self.pill = Pill()
        self.summary = QLabel()
        self.summary.setWordWrap(True)
        self.summary.setAlignment(Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft)
        self.summary.setSizePolicy(QSizePolicy.Policy.Ignored, QSizePolicy.Policy.Expanding)
        self.gauge_box = QVBoxLayout()
        self.gauge_box.setContentsMargins(0, 0, 0, 0)

        top = QHBoxLayout()
        top.setSpacing(8)
        top.addWidget(self.icon)
        top.addWidget(self.title, 1)
        top.addWidget(self.pill)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(16, 10, 12, 10)
        lay.setSpacing(4)
        lay.addLayout(top)
        lay.addWidget(self.summary, 1)
        lay.addLayout(self.gauge_box)
        self.set_check(check)

    def set_check(self, check):
        self.check = check
        st = shown_status(check)
        self.icon.setPixmap(theme_icon(self.cid).pixmap(QSize(24, 24)))
        self.title.setText(check.get("title", ""))
        self.pill.set_status(st)
        self.summary.setStyleSheet(f"color: {muted().name()};")
        self.full_summary = check.get("summary", "")
        self.setToolTip(self.full_summary)
        while self.gauge_box.count():
            self.gauge_box.takeAt(0).widget().deleteLater()
        gauges = check.get("gauges") or []
        if gauges:
            # The fullest bar is the most interesting one for the overview
            self.gauge_box.addWidget(GaugeBar(max(gauges, key=lambda g: g["value"]) if self.cid == "space"
                                              else gauges[0], compact=True))
        self.elide()
        self.update()

    def elide(self):
        """Fit the summary into the lines that are free on the card."""
        lines = 1 if self.check.get("gauges") else 2
        fm = QFontMetrics(self.summary.font())
        width = max(self.summary.width(), 50)
        text, out = self.full_summary, []
        for i in range(lines):
            if i == lines - 1:
                out.append(fm.elidedText(text, Qt.TextElideMode.ElideRight, width))
                break
            # break at the last space that still fits
            cut = len(text)
            while cut > 0 and fm.horizontalAdvance(text[:cut]) > width:
                cut = text.rfind(" ", 0, cut)
            if cut <= 0:
                cut = len(text)
            out.append(text[:cut])
            text = text[cut:].lstrip()
            if not text:
                break
        self.summary.setText("\n".join(out))

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.elide()

    def set_selected(self, on):
        self.selected = on
        self.update()

    def enterEvent(self, _):
        self.hover = True
        self.update()

    def leaveEvent(self, _):
        self.hover = False
        self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit(self.cid)

    def keyPressEvent(self, e):
        if e.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Space):
            self.clicked.emit(self.cid)
        else:
            super().keyPressEvent(e)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        base = pal(QPalette.ColorRole.Base)
        text = pal(QPalette.ColorRole.WindowText)
        st = shown_status(self.check)
        c = status_color(st)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        bg = mix(base, c, 0.07) if st in ("warn", "fail") else base
        if self.hover and self.rect().contains(self.mapFromGlobal(QCursor.pos())):
            bg = mix(bg, text, 0.04)
        path = QPainterPath()
        path.addRoundedRect(r, 8, 8)
        p.fillPath(path, bg)
        # status stripe on the left
        p.save()
        p.setClipPath(path)
        p.fillRect(QRectF(r.left(), r.top(), 5, r.height()), c)
        p.restore()
        if self.selected:
            p.setPen(QPen(pal(QPalette.ColorRole.Highlight), 2))
        elif self.hasFocus():
            p.setPen(QPen(mix(pal(QPalette.ColorRole.Highlight), base, 0.4), 1.5))
        else:
            p.setPen(QPen(mix(text, base, 0.82), 1))
        p.drawPath(path)


class CardGrid(QWidget):
    """Cards in as many columns as fit the width."""

    def __init__(self):
        super().__init__()
        self.cards = []
        self.grid = QGridLayout(self)
        self.grid.setContentsMargins(0, 0, 4, 0)
        self.grid.setSpacing(12)
        self.cols = 0

    def set_cards(self, cards):
        for c in self.cards:
            if c not in cards:
                c.setParent(None)
                c.deleteLater()
        self.cards = cards
        self.cols = 0
        self.relayout()

    def relayout(self):
        cols = max(1, min(3, (self.width() + 12) // (Card.HEIGHT * 2 + 52)))
        if cols == self.cols and self.grid.count() == len(self.cards):
            return
        self.cols = cols
        while self.grid.count():
            self.grid.takeAt(0)
        for i, c in enumerate(self.cards):
            self.grid.addWidget(c, i // cols, i % cols)
        for col in range(3):
            self.grid.setColumnStretch(col, 1 if col < cols else 0)
        self.grid.setRowStretch(len(self.cards) // cols + 1, 1)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.relayout()


