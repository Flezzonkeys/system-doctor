class DetailPanel(QFrame):
    seen_changed = pyqtSignal(list, bool)  # event keys, True = mark as seen

    def __init__(self):
        super().__init__()
        self.check = None
        self.seen_keys = []
        self.seen_mode = True
        self.setMinimumWidth(340)
        self.setObjectName("detail")

        self.icon = QLabel()
        self.title = QLabel()
        tf = self.title.font()
        tf.setBold(True)
        tf.setPointSizeF(tf.pointSizeF() * 1.35)
        self.title.setFont(tf)
        self.pill = Pill()
        self.summary = QLabel()
        self.summary.setWordWrap(True)
        self.summary.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.gauges = QVBoxLayout()
        self.gauges.setSpacing(6)
        self.body = QLabel()
        self.body.setWordWrap(True)
        self.body.setTextFormat(Qt.TextFormat.RichText)
        self.body.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.body.setAlignment(Qt.AlignmentFlag.AlignTop | Qt.AlignmentFlag.AlignLeft)
        self.copy_btn = QPushButton(QIcon.fromTheme("edit-copy"), "Copy")
        self.copy_btn.setToolTip("Copy this section as text")
        self.copy_btn.clicked.connect(self.copy)
        self.seen_btn = QPushButton()
        self.seen_btn.clicked.connect(lambda: self.seen_changed.emit(self.seen_keys, self.seen_mode))
        self.line = QFrame()
        self.line.setFrameShape(QFrame.Shape.HLine)

        head = QHBoxLayout()
        head.setSpacing(10)
        head.addWidget(self.icon)
        head.addWidget(self.title, 1)
        head.addWidget(self.pill)

        inner = QWidget()
        il = QVBoxLayout(inner)
        il.setContentsMargins(0, 0, 8, 0)
        il.setSpacing(12)
        il.addWidget(self.summary)
        il.addLayout(self.gauges)
        il.addWidget(self.body)
        il.addStretch(1)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setWidget(inner)
        scroll.viewport().setAutoFillBackground(False)
        inner.setAutoFillBackground(False)

        foot = QHBoxLayout()
        foot.addWidget(self.seen_btn)
        foot.addStretch(1)
        foot.addWidget(self.copy_btn)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(20, 16, 16, 12)
        lay.setSpacing(12)
        lay.addLayout(head)
        lay.addWidget(self.line)
        lay.addWidget(scroll, 1)
        lay.addLayout(foot)

    def show_check(self, check, seen):
        self.check = check
        st = shown_status(check)
        self.line.setStyleSheet(f"color: {mix(pal(QPalette.ColorRole.WindowText), pal(QPalette.ColorRole.Base), 0.85).name()};")
        new = unseen_keys(check, seen)
        if new:
            self.seen_keys, self.seen_mode = new, True
            self.seen_btn.setIcon(QIcon.fromTheme("dialog-ok-apply", QIcon.fromTheme("dialog-ok")))
            self.seen_btn.setText("Mark as seen" if len(new) == 1 else f"Mark {len(new)} as seen")
            self.seen_btn.setToolTip("Hide this warning until something new happens")
        elif check.get("seen_count"):
            self.seen_btn.setIcon(QIcon.fromTheme("edit-undo"))
            self.seen_keys, self.seen_mode = [e["key"] for e in check.get("events", [])], False
            self.seen_btn.setText("Show again")
            self.seen_btn.setToolTip("Show the warnings you marked as seen again")
        self.seen_btn.setVisible(bool(new) or bool(check.get("seen_count")))
        self.icon.setPixmap(theme_icon(check["id"]).pixmap(QSize(32, 32)))
        self.title.setText(check.get("title", ""))
        self.pill.set_status(st)
        self.summary.setText(check.get("summary", ""))
        while self.gauges.count():
            self.gauges.takeAt(0).widget().deleteLater()
        for g in check.get("gauges") or []:
            self.gauges.addWidget(GaugeBar(g))
        self.body.setText(self.render(check.get("details", [])))

    @staticmethod
    def render(details):
        """Details as a table: 'Key: value' rows, indented lines as sub rows, the rest as notes."""
        mc = muted().name()
        rows = []
        for i, d in enumerate(details):
            if d.startswith("    "):
                rows.append(f"<tr><td colspan='2' style='color:{mc}; padding:1px 0 1px 16px'>{escape(d.strip())}</td></tr>")
                continue
            key, sep, val = d.partition(": ")
            has_children = i + 1 < len(details) and details[i + 1].startswith("    ")
            if has_children and not d.endswith(":"):
                text = f"<b>{escape(key)}</b>" + (f"&nbsp;&nbsp;{escape(val)}" if sep else "")
                rows.append(f"<tr><td colspan='2' style='padding:8px 0 1px 0'>{text}</td></tr>")
            elif sep and len(key) <= 34 and val:
                rows.append(f"<tr><td width='1%' style='color:{mc}; padding:5px 14px 1px 0; white-space:nowrap' valign='top'>"
                            f"{escape(key)}</td><td style='padding:5px 0 1px 0'>{escape(val)}</td></tr>")
            elif d.endswith(":"):
                rows.append(f"<tr><td colspan='2' style='padding:8px 0 1px 0'><b>{escape(d[:-1])}</b></td></tr>")
            else:
                rows.append(f"<tr><td colspan='2' style='color:{mc}; padding:8px 0 1px 0'><i>{escape(d)}</i></td></tr>")
        if not rows:
            return f"<span style='color:{mc}'>No further details.</span>"
        return "<table width='100%' cellspacing='0' cellpadding='0'>" + "".join(rows) + "</table>"

    def copy(self):
        if self.check:
            QApplication.clipboard().setText(plain_text(self.check))
            self.copy_btn.setText("Copied")
            QTimer.singleShot(1500, lambda: self.copy_btn.setText("Copy"))

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        base = pal(QPalette.ColorRole.Base)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        path = QPainterPath()
        path.addRoundedRect(r, 8, 8)
        p.fillPath(path, base)
        p.setPen(QPen(mix(pal(QPalette.ColorRole.WindowText), base, 0.82), 1))
        p.drawPath(path)


# ---------------------------------------------------------------- header
class Header(QFrame):
    def __init__(self):
        super().__init__()
        self.status = "ok"
        self.badge = StatusBadge()
        self.headline = QLabel()
        hf = self.headline.font()
        hf.setBold(True)
        hf.setPointSizeF(hf.pointSizeF() * 1.6)
        self.headline.setFont(hf)
        self.subline = QLabel()
        self.machine = QLabel()
        self.counts = QHBoxLayout()
        self.counts.setSpacing(6)

        self.run_btn = QPushButton(QIcon.fromTheme("view-refresh"), "Run check now")
        self.run_btn.setToolTip("Run all checks again (F5)")
        self.run_btn.setMinimumHeight(34)
        self.run_btn.setMinimumWidth(150)
        self.theme_btn = QPushButton()
        self.theme_btn.setMinimumHeight(34)
        self.seen_all_btn = QPushButton(QIcon.fromTheme("dialog-ok-apply", QIcon.fromTheme("dialog-ok")),
                                        "Mark all as seen")
        self.seen_all_btn.setToolTip("Hide all current crash, log and service warnings until something new happens")
        self.seen_all_btn.setMinimumHeight(34)

        text = QVBoxLayout()
        text.setSpacing(2)
        text.addWidget(self.headline)
        text.addWidget(self.subline)
        text.addWidget(self.machine)

        right = QVBoxLayout()
        right.setSpacing(8)
        buttons = QHBoxLayout()
        buttons.setSpacing(8)
        buttons.addStretch(1)
        buttons.addWidget(self.theme_btn)
        buttons.addWidget(self.seen_all_btn)
        buttons.addWidget(self.run_btn)
        right.addLayout(buttons)
        right.addLayout(self.counts)
        right.addStretch(1)

        lay = QHBoxLayout(self)
        lay.setContentsMargins(20, 16, 20, 16)
        lay.setSpacing(16)
        lay.addWidget(self.badge, 0, Qt.AlignmentFlag.AlignTop)
        lay.addLayout(text, 1)
        lay.addLayout(right)

    def set_counts(self, counts):
        while self.counts.count():
            item = self.counts.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        self.counts.addStretch(1)
        for st, word in (("ok", "OK"), ("warn", "warning"), ("fail", "problem")):
            n = counts.get(st, 0)
            if n or st == "ok":
                pill = Pill()
                pill.set_status(st, f"{n} {word}" + ("s" if n != 1 and st != "ok" else ""))
                self.counts.addWidget(pill)

    def set_dark(self, dark):
        self.theme_btn.setText("Light mode" if dark else "Dark mode")
        self.theme_btn.setIcon(QIcon.fromTheme("weather-clear" if dark else "weather-clear-night"))
        self.theme_btn.setToolTip(f"Switch to the {'light' if dark else 'dark'} theme (Ctrl+T)")

    def set_status(self, status):
        self.status = status
        self.badge.set_status(status)
        self.headline.setStyleSheet(f"color: {status_color(status).name()};")
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        base = pal(QPalette.ColorRole.Base)
        c = status_color(self.status)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        path = QPainterPath()
        path.addRoundedRect(r, 10, 10)
        p.fillPath(path, mix(base, c, 0.10))
        p.setPen(QPen(mix(base, c, 0.35), 1))
        p.drawPath(path)


# ---------------------------------------------------------------- window
class Window(QWidget):
    def __init__(self, report_path, theme):
        super().__init__()
        self.report_path = report_path
        self.theme = theme
        self.report = None
        self.seen = load_seen()
        self.setWindowTitle("System Doctor")
        # Loaded by path: some icon themes would otherwise pick a similar named icon ("system")
        icon_file = "/usr/local/share/icons/hicolor/scalable/apps/system-doctor.svg"
        self.setWindowIcon(QIcon(icon_file) if os.path.exists(icon_file) else QIcon.fromTheme("utilities-system-monitor"))
        self.resize(1120, 760)
        self.setMinimumSize(760, 540)
        self._mtime = None
        self._running = False
        self.cards = {}
        self.selected = None

        self.header = Header()
        self.header.run_btn.clicked.connect(self.run_check)
        self.header.theme_btn.clicked.connect(self.toggle_theme)
        self.header.seen_all_btn.clicked.connect(self.mark_all_seen)
        self.header.set_dark(theme == "dark")

        self.grid = CardGrid()
        grid_scroll = QScrollArea()
        grid_scroll.setWidgetResizable(True)
        grid_scroll.setFrameShape(QFrame.Shape.NoFrame)
        grid_scroll.setWidget(self.grid)
        grid_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)

        self.detail = DetailPanel()
        self.detail.seen_changed.connect(self.set_seen)
        self.splitter = QSplitter(Qt.Orientation.Horizontal)
        self.splitter.addWidget(grid_scroll)
        self.splitter.addWidget(self.detail)
        self.splitter.setStretchFactor(0, 3)
        self.splitter.setStretchFactor(1, 2)
        self.splitter.setChildrenCollapsible(False)
        self.splitter.setHandleWidth(12)
        self.splitter.setSizes([680, 420])

        self.empty = QLabel("No check has run yet.\nClick \"Run check now\" to start the first check.")
        self.empty.setAlignment(Qt.AlignmentFlag.AlignCenter)
        ef = self.empty.font()
        ef.setPointSizeF(ef.pointSizeF() * 1.2)
        self.empty.setFont(ef)

        self.footer = QLabel()
        self.footer.setStyleSheet(f"color: {muted().name()};")

        lay = QVBoxLayout(self)
        lay.setContentsMargins(14, 14, 14, 8)
        lay.setSpacing(12)
        lay.addWidget(self.header)
        lay.addWidget(self.splitter, 1)
        lay.addWidget(self.empty, 1)
        lay.addWidget(self.footer)

        QShortcut(QKeySequence("F5"), self, activated=self.run_check)
        QShortcut(QKeySequence("Ctrl+Q"), self, activated=self.close)
        QShortcut(QKeySequence("Ctrl+C"), self, activated=self.detail.copy)
        QShortcut(QKeySequence("Ctrl+T"), self, activated=self.toggle_theme)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(1500)
        self.refresh()

    # ------------------------------------------------------------ data
    def refresh(self):
        running = is_running() if self.report_path == REPORT else False
        changed_run = running != self._running
        self._running = running
        btn = self.header.run_btn
        btn.setEnabled(not running and self.report_path == REPORT)
        btn.setText("Checking..." if running else "Run check now")

        try:
            mtime = os.path.getmtime(self.report_path)
        except OSError:
            self.show_empty(True)
            self.header.set_status("warn")
            self.header.headline.setText("No report yet")
            self.header.subline.setText("Checking..." if running else "System Doctor has not run a check yet.")
            return
        if mtime == self._mtime and not changed_run:
            return
        self._mtime = mtime
        try:
            with open(self.report_path, encoding="utf-8") as f:
                report = json.load(f)
        except (OSError, ValueError):
            return
        self.show_empty(False)
        self.report = report
        self.apply(report, running)

    def show_empty(self, on):
        self.empty.setVisible(on)
        self.splitter.setVisible(not on)

    def apply(self, report, running):
        raw = report.get("checks", [])
        checks = [effective(c, self.seen) for c in raw]
        overall = "ok"
        for c in checks:
            if not c.get("info") and RANK.get(c["status"], 0) > RANK[overall]:
                overall = c["status"]
        self.header.seen_all_btn.setVisible(any(unseen_keys(c, self.seen) for c in raw))
        self.footer.setStyleSheet(f"color: {muted().name()};")
        self.header.set_status(overall)
        self.header.headline.setText(HEADLINES.get(overall, ""))
        sub = f"Last check: {fmt_time(report.get('time', 0))}"
        nxt = next_run() if self.report_path == REPORT else None
        if running:
            sub += "   |   running a new check..."
        elif nxt:
            sub += f"   |   next check: {fmt_time(nxt)}"
        self.header.subline.setText(sub)
        sysinfo = next((c for c in checks if c["id"] == "sysinfo"), None)
        self.header.machine.setText(sysinfo["summary"] if sysinfo else "")
        self.header.machine.setStyleSheet(f"color: {muted().name()};")
        counts = {}
        for c in checks:
            if not c.get("info"):
                counts[c["status"]] = counts.get(c["status"], 0) + 1
        self.header.set_counts(counts)

        cards = []
        for c in checks:
            card = self.cards.get(c["id"])
            if card:
                card.set_check(c)
            else:
                card = Card(c)
                card.clicked.connect(self.select)
                self.cards[c["id"]] = card
            cards.append(card)
        ids = {c["id"] for c in checks}
        self.cards = {k: v for k, v in self.cards.items() if k in ids}
        self.grid.set_cards(cards)

        if self.selected not in ids:
            problem = next((c["id"] for c in checks if not c.get("info") and c["status"] != "ok"), None)
            self.selected = problem or (checks[0]["id"] if checks else None)
        if self.selected:
            self.select(self.selected)

        version = report.get("version", "")
        self.footer.setText(f"System Doctor {VERSION}" + (f"  (checker {version})" if version and version != VERSION
                                                           else "") +
                            "   |   checks run automatically 10 minutes after boot and once a day   |   F5 to check now")

    def select(self, cid):
        self.selected = cid
        for k, card in self.cards.items():
            card.set_selected(k == cid)
        if cid in self.cards:
            self.detail.show_check(self.cards[cid].check, self.seen)

    # ------------------------------------------------------------ actions
    def reapply(self):
        if self.report:
            self.apply(self.report, self._running)
        for w in self.findChildren(QWidget):
            w.update()

    def set_seen(self, keys, add):
        self.seen = (self.seen | set(keys)) if add else (self.seen - set(keys))
        save_seen(self.seen, (self.report or {}).get("checks", []))
        self.reapply()

    def mark_all_seen(self):
        keys = [k for c in (self.report or {}).get("checks", []) for k in unseen_keys(c, self.seen)]
        self.set_seen(keys, True)

    def toggle_theme(self):
        self.theme = "light" if self.theme == "dark" else "dark"
        QApplication.instance().setPalette(make_palette(self.theme))
        settings = load_json(SETTINGS, {})
        settings["theme"] = self.theme
        save_json(SETTINGS, settings)
        self.header.set_dark(self.theme == "dark")
        self.reapply()

    def run_check(self):
        if self._running or self.report_path != REPORT:
            return
        self.header.run_btn.setEnabled(False)
        self.header.run_btn.setText("Checking...")
        p = subprocess.run(["systemctl", "start", "--no-block", SERVICE], capture_output=True, text=True)
        if p.returncode != 0:
            QMessageBox.warning(self, "System Doctor", "Could not start the check:\n" + p.stderr.strip())
        QTimer.singleShot(400, self.refresh)


def main():
    args = sys.argv[1:]
    report = REPORT
    shot = None
    if "--report" in args and args.index("--report") + 1 < len(args):
        report = args[args.index("--report") + 1]
    if "--screenshot" in args and args.index("--screenshot") + 1 < len(args):
        shot = args[args.index("--screenshot") + 1]
    pick = args[args.index("--select") + 1] if "--select" in args and args.index("--select") + 1 < len(args) else None
    if "--version" in args:
        print(f"system-doctor-gui {VERSION}")
        return
    theme = load_json(SETTINGS, {}).get("theme", "dark")
    if "--theme" in args and args.index("--theme") + 1 < len(args):
        theme = args[args.index("--theme") + 1]
    theme = theme if theme in THEMES else "dark"
    app = QApplication(sys.argv[:1])
    app.setApplicationName("System Doctor")
    app.setDesktopFileName("system-doctor")
    # Fusion draws everything from our palette, so both themes look the same on every desktop
    app.setStyle("Fusion")
    app.setPalette(make_palette(theme))
    w = Window(report, theme)
    w.show()
    if pick:
        w.select(pick)
    if shot:
        QTimer.singleShot(1200, lambda: (w.grab().save(shot), app.quit()))
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
